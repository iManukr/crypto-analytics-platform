                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "defaultdb",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT c.close_price * f.rate AS \"ETH/KES\"\nFROM crypto.market_candles_1m c\nCROSS JOIN LATERAL (\n  SELECT rate FROM crypto.fx_rates\n  WHERE base = 'USD' AND quote = 'KES'\n  ORDER BY as_of DESC LIMIT 1\n) f\nWHERE c.symbol = 'ETHUSDT'\nORDER BY c.open_time DESC LIMIT 1;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
