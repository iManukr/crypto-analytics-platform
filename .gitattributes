# =============================================================================
# Line endings.
#
# This is not cosmetic. Every shell script in infra/ and scripts/ is bind-mounted
# into a Linux container and executed there. Checked out with CRLF on Windows,
# the shebang becomes "#!/usr/bin/env bash\r" and the container fails with
# "bad interpreter: no such file or directory" - which reads like a missing
# binary rather than a line-ending problem and costs an hour to diagnose.
#
# Forcing LF in the repository and on checkout removes the failure mode entirely.
# =============================================================================
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.sql     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.toml    text eol=lf
*.cfg     text eol=lf
Makefile  text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# Binary - never touch these.
*.png binary
*.jpg binary
*.gz  binary

# Keep generated artefacts out of diffs and language statistics.
dbt/target/**   linguist-generated=true
