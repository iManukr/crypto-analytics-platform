# ---- Secrets & credentials (NEVER commit) ----
.env
.env.*
!.env.example
certificates/
*.pem
*.cert
*.key
ca.pem
# Scoped to the certificates directory on purpose. A bare `service.*` here -
# which is what this was - also matches ingestion/service.py and silently
# excludes the ingestion loop from the repository.
certificates/service.*

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/
.conda/

# ---- dbt ----
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# ---- Airflow ----
airflow/logs/
airflow/*.cfg
airflow/*.db
airflow/webserver_config.py

# ---- Runtime state shared between containers ----
.state/

# ---- Jupyter / Colab ----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- IDE / editor ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs & local data ----
*.log
*.tmp
*.csv
!dbt/seeds/*.csv
!tests/fixtures/*.csv
.claude/

# Written by the ClickHouse entrypoint at container start from
# CLICKHOUSE_USER/CLICKHOUSE_PASSWORD. Generated, not authored.
infra/clickhouse/users.d/default-user.xml
