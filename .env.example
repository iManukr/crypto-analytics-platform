# =============================================================================
# crypto-analytics-platform - environment template
# -----------------------------------------------------------------------------
# Copy to .env and adjust. Every value below has a working default, so
#   cp .env.example .env && docker compose up -d
# is enough to bring the whole stack up locally.
#
# NOTE: the credentials here are LOCAL-ONLY development defaults. They are
# committed on purpose so a reviewer can run the stack with one command.
# Never reuse them anywhere that is reachable from outside your machine.
# =============================================================================

# ---------------------------------------------------------------- data source
# Which external REST API to ingest from.
#   binance -> https://api.binance.com/api/v3/klines   (public, no auth)
#   replay  -> deterministic offline generator (no network; used by CI)
INGEST_SOURCE=binance

# Comma-separated Binance host failover list. The ingester walks the list on
# HTTP 4xx/5xx/timeout. api.binance.com is geo-restricted in some regions;
# api.binance.us and the GCP mirror are the usual escape hatches.
BINANCE_HOSTS=https://api.binance.com,https://api-gcp.binance.com,https://api.binance.us

# If the live API is unreachable for this many consecutive cycles, fall back to
# the replay source so the pipeline keeps producing data. 0 disables fallback.
INGEST_FALLBACK_AFTER_FAILURES=3

# Trading pairs to ingest (comma-separated).
SYMBOLS=ETHUSDT,BTCUSDT

# Seconds between ingestion cycles.
INGEST_INTERVAL_SECONDS=20

# Minutes of history the ingester republishes on startup, to heal the gap left
# by whatever downtime preceded it. Idempotent - overshooting is harmless.
BACKFILL_MINUTES=180

# --------------------------------------------------------------------- FX leg
FX_BASE=USD
FX_QUOTE=KES
FX_REFRESH_SECONDS=900

# ---------------------------------------------------------- Postgres  (OLTP)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crypto
POSTGRES_USER=crypto_app
POSTGRES_PASSWORD=crypto_app_pw
# Superuser, used only by the init scripts and by psql in the Makefile targets.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_pw
# Dedicated replication role consumed by Debezium.
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=debezium_pw
# Host port the OLTP database is published on.
POSTGRES_PUBLISHED_PORT=5432

# ------------------------------------------------------------------ Kafka
KAFKA_BOOTSTRAP=kafka:29092
KAFKA_PUBLISHED_PORT=9092
KAFKA_CLUSTER_ID=Nk2ROnZ1RtSAKBGpJmXqEw
# Topic prefix Debezium uses; topics become <prefix>.<schema>.<table>
CDC_TOPIC_PREFIX=cdc
KAFKA_CONNECT_URL=http://connect:8083

# ------------------------------------------------------------- ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_METRICS_PORT=9363
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=analytics_pw
CLICKHOUSE_PUBLISHED_HTTP_PORT=8123
# Consumer group used by the ClickHouse Kafka engine tables.
CLICKHOUSE_KAFKA_GROUP=clickhouse-cdc

# --------------------------------------------------------------- Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_PUBLISHED_PORT=8080
AIRFLOW_METADATA_DB=airflow
AIRFLOW_METADATA_USER=airflow
AIRFLOW_METADATA_PASSWORD=airflow_pw
# Fernet key for connection encryption. Generate your own for anything real:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=UKMzEm3yIuFYEq3y3-2rvZWUD_qMkFhOZ1t2Vd0kkPI=
AIRFLOW_SCHEDULE_CRON=*/15 * * * *

# --------------------------------------------------------- Observability
PROMETHEUS_PUBLISHED_PORT=9090
GRAFANA_PUBLISHED_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
EXPORTER_PORT=9101
INGESTION_METRICS_PORT=8000

# Freshness budget, in seconds, before the pipeline is considered stale.
# Drives both the Prometheus alert and the Airflow freshness sensor.
FRESHNESS_SLA_SECONDS=300
# CDC lag budget, in seconds (Postgres commit -> row visible in ClickHouse).
CDC_LAG_SLA_SECONDS=120
